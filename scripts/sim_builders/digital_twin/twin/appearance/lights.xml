<mujocoinclude>
  <!-- Appearance pass 2026-10-30: WORLDBODY include. Replaces detail_key / detail_fill / soft_shadow_0..3 of the clippers_only scene.
       Real room: lit softly from the -y side (image left of the top view), soft shadows falling toward +y. Directions in the table
       frame (x toward the front wall, y to the image right, z up). MuJoCo has hard shadow maps only: the key is split in three
       shadowed directional lights 5 deg apart (penumbra), each a third of the key power, on top of a bright unshadowed fill and
       the ambient term in lights_visual.xml. Shadow depth on the desk = (ambient + fill) / (ambient + fill + key) ~ 0.7. -->
  <!-- key from -y, 45 deg elevation, slight +x lean -->
  <light name="key_a" directional="true" pos="0.3 -1.5 1.5" dir="0.15 0.69 -0.71" diffuse=".17 .17 .17" specular=".12 .12 .12" castshadow="true" />
  <light name="key_b" directional="true" pos="0.3 -1.5 1.5" dir="0.21 0.69 -0.69" diffuse=".17 .17 .17" specular=".12 .12 .12" castshadow="true" />
  <light name="key_c" directional="true" pos="0.3 -1.5 1.5" dir="0.09 0.72 -0.69" diffuse=".17 .17 .17" specular=".12 .12 .12" castshadow="true" />
  <!-- fill: ceiling light from above-behind the robot (lights the front wall too), no shadow -->
  <light name="fill_top" directional="true" pos="-0.5 0 2.0" dir="0.55 0.1 -0.83" diffuse=".30 .30 .30" specular=".05 .05 .05" castshadow="false" />
  <!-- bounce from the +y side so the shadowed flanks of objects are not black -->
  <light name="fill_side" directional="true" pos="0.3 1.5 1.0" dir="0 -0.8 -0.6" diffuse=".10 .10 .10" specular="0 0 0" castshadow="false" />
</mujocoinclude>
