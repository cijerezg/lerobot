    <camera name="ext" pos="0.60900 -0.01395 0.84855" quat="0.716093 0.064734 0.080219 0.690351" fovy="60.730" />
    <!-- headphone_case: the loaded base half (headphones inside), fixed to the table so a push on the lid cannot slide it. headphone_lid: the empty half on joint lid_hinge. lid_hinge = 0 is the recorded flat-open pose (lid resting on the table toward the robot); positive = closing; CLOSED = 3.1416 rad (pi): the lid rim meets the base rim exactly, both shells being mirror images about the hinge line at rim height. Score 'closed' as lid_hinge > 2.9 rad. Gravity holds the lid open below ~1.83 rad (lid centre of mass passes over the hinge there) and shut above it; the upper joint limit is the stop at closed. -->
    <body name="headphone_case" pos="0.41892 0.01740 0.02000" quat="-0.516352 0 0 0.856376">
      <geom name="headphone_case_block_a" type="box" group="3" size="0.08800 0.06200 0.01580" pos="0.00000 0.00000 -0.00420" quat="0.240433 0 0 -0.970666" mass="0.0700" condim="4" friction="0.8 0.005 0.0001" />
